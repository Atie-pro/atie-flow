# Copia este archivo a .env. Los valores de abajo sirven solo para desarrollo local.
# No uses este secreto ni esta contraseña en un entorno compartido o de producción.
# Genera otro secreto con: openssl rand -base64 32

DATABASE_URL=postgresql://atie:atie@localhost:5432/atie_flow
BETTER_AUTH_SECRET=desarrollo-local-atie-flow-no-usar-en-produccion-0001
BETTER_AUTH_URL=http://localhost:3000

# Usuario administrador que crea `pnpm db:seed`. Si cambias la contraseña, vuelve a sembrar.
SEED_ADMIN_EMAIL=admin@atie.com.ec
SEED_ADMIN_NAME=Admin ATIE
SEED_ADMIN_PASSWORD=atie-dev-cambiar

# Opcional. Si ambos valores de un proveedor están presentes, el inicio de sesión corporativo queda activo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
